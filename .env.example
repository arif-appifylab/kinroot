# For `npm run dev` on YOUR OWN machine only (the editor and the deployed site
# get these from the platform). Copy to .env, which git ignores — never commit it.

# The site's own address as the platform shows it (Settings), where the platform
# answers /api/*: the brand and relayed emails. Empty = those parts are skipped.
SITE_URL=

# The Site Database to develop against (a Prisma Postgres connection string;
# the Preview Database's, from the site's Database tab). Empty = no database:
# sign-in and the CRM answer that the Site Database is not enabled.
DATABASE_URL=

# Signs access tokens. Locally, any random string of 32+ characters
# (e.g. `openssl rand -base64 48`). The platform sets its own when deployed.
JWT_SECRET=

# Optional: a Site Key, so password-reset and confirmation emails are relayed.
SITE_KEY=

# Optional: `1` behaves like the editor Preview. Never set on a live site.
SITE_PREVIEW=

# Set by the platform: an opaque id for the account's owner, never an email. The owner
# comes only from "View as admin" in the dashboard, here too if this copy has a Site Key.
SITE_OWNER_ID=
