---
/** Report emails: a link someone was emailed (src/crm/public/report-unsubscribe.tsx). The state is read in-process; a bad link says so. */
import ReportUnsubscribePage from '../../crm/public/report-unsubscribe';
import CrmPublic from '../../layouts/CrmPublic.astro';
import {crmBrand, crmGet} from '../../server/crm/page';


export const prerender = false;

const token = Astro.params.token ?? '';
const [brand, res] = await Promise.all([crmBrand(Astro.request), crmGet<{email: string; name: string; subscribed: boolean}>(Astro.request, `/public/report-unsubscribe/${encodeURIComponent(token)}`)]);
if (!res.data) Astro.response.status = res.status === 404 ? 404 : 503;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---

<CrmPublic brand={brand} title="Report emails" noindex>
  <ReportUnsubscribePage client:only="react" brand={brand} token={token} initial={res.data} />
</CrmPublic>
