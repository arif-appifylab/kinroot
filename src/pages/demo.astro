---
/**
 * The company website's Book a demo page (Kinroot's Settings → Website), rendered on the server and hydrated
 * (src/crm/public/site-page.tsx). Not set up: a 404 that says so; the read failed: 503.
 */
import SitePage from '../crm/public/site-page';
import CrmPublic from '../layouts/CrmPublic.astro';
import {websitePage, WEBSITE_CACHE} from '../server/crm/site-page';

export const prerender = false;

const {site, brand} = await websitePage(Astro.request);
const ready = !!site && site.enabled && !!site.demo;
Astro.response.status = !site ? 503 : ready ? 200 : 404;
if (ready) Astro.response.headers.set('Cache-Control', WEBSITE_CACHE);
const name = brand.name || 'us';
---

<CrmPublic brand={brand} title="Book a demo" description={`Book a ${site?.demo?.minutes ?? 30}-minute demo with ${name}: pick a time that suits you and get the invite by email.`} indexable={ready} noindex={!ready}>
  {
    site ? (
      <SitePage client:load site={site} brand={brand} page="demo" />
    ) : (
      <main class="grid min-h-screen place-items-center p-6 text-center">
        <div>
          <h1 class="text-xl font-bold">This page is not available right now</h1>
          <p class="mt-2 text-sm text-muted-foreground">Please try again in a few minutes.</p>
        </div>
      </main>
    )
  }
</CrmPublic>
