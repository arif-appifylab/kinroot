---
/**
 * The company's website home (Kinroot's Settings → Website): rendered on the server for every visit,
 * hydrated for the menu and the chat bubble (src/crm/public/site-page.tsx). With the website off,
 * `/` opens the CRM (sign-in first when signed out), as Kinroot always did.
 */
import SitePage from '../crm/public/site-page';
import CrmPublic from '../layouts/CrmPublic.astro';
import {websitePage, WEBSITE_CACHE} from '../server/crm/site-page';

export const prerender = false;

const {site, brand} = await websitePage(Astro.request);
if (site && !site.enabled) return Astro.redirect('/crm/', 302);
if (!site) Astro.response.status = 503;
else Astro.response.headers.set('Cache-Control', WEBSITE_CACHE);
// Without a headline the home page still describes itself (AUDIT-2 L-15): a highlight, else the company and what the site offers.
const highlight = site?.highlights.find((h) => h.text?.trim());
const offers = site ? ['get in touch', site.demo ? 'book a demo' : '', site.support ? 'get support' : ''].filter(Boolean) : [];
const fallback = site ? `${brand.name}: ${offers.length > 1 ? `${offers.slice(0, -1).join(', ')} or ${offers.at(-1)}` : offers[0]}.` : undefined;
const description = (site?.subheadline?.trim() || site?.headline?.trim() || highlight?.text.trim() || fallback)?.slice(0, 300);
---

<CrmPublic brand={brand} description={description} indexable={!!site} noindex={!site}>
  {
    site ? (
      <SitePage client:load site={site} brand={brand} page="home" />
    ) : (
      <main class="grid min-h-screen place-items-center p-6 text-center">
        <div>
          <h1 class="text-xl font-bold">This site is not available right now</h1>
          <p class="mt-2 text-sm text-muted-foreground">Please try again in a few minutes.</p>
        </div>
      </main>
    )
  }
</CrmPublic>
