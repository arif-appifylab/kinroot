---
/** Email preferences: a link someone was emailed (src/crm/public/unsubscribe.tsx). The state is read in-process; a bad link says so. */
import UnsubscribePage from '../../crm/public/unsubscribe';
import CrmPublic from '../../layouts/CrmPublic.astro';
import {crmBrand, crmGet} from '../../server/crm/page';


export const prerender = false;

const token = Astro.params.token ?? '';
const [brand, res] = await Promise.all([crmBrand(Astro.request), crmGet<{email: string | null; optedOut: boolean}>(Astro.request, `/public/unsubscribe/${encodeURIComponent(token)}`)]);
if (!res.data) Astro.response.status = res.status === 404 ? 404 : 503;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---

<CrmPublic brand={brand} title="Email preferences" noindex>
  <UnsubscribePage client:only="react" brand={brand} token={token} initial={res.data} />
</CrmPublic>
