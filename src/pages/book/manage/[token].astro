---
/** Reschedule or cancel a booking from the signed link in the confirmation email (src/crm/public/booking-manage.tsx). */
import type {BookedMeeting} from '../../../crm/components/booking/booking-widget';
import ManageBookingPage from '../../../crm/public/booking-manage';
import CrmPublic from '../../../layouts/CrmPublic.astro';
import {crmBrand, crmGet} from '../../../server/crm/page';

export const prerender = false;

const token = Astro.params.token ?? '';
const action = Astro.url.searchParams.get('action');
const [brand, res] = await Promise.all([crmBrand(Astro.request), crmGet<{booking: BookedMeeting}>(Astro.request, `/public/booking/manage/${encodeURIComponent(token)}`)]);
const booking = res.data?.booking ?? null;
if (!booking) Astro.response.status = res.status === 404 || res.status === 400 ? 404 : 503;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---

<CrmPublic brand={brand} title="Your meeting" noindex>
  <ManageBookingPage client:only="react" brand={brand} token={token} booking={booking} action={action === 'reschedule' || action === 'cancel' ? action : undefined} />
</CrmPublic>
