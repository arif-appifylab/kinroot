---
/**
 * The template dashboard's address. Kinroot is the site's app now: `/dashboard/<anything>?<query>`
 * opens it at `/crm/` (or the Kinroot screen that replaced that one: `src/server/legacy-addresses.ts`),
 * KEEPING the query string: the platform's one-click owner sign-in arrives as
 * `/portal/?owner_ticket=…` → here, and Kinroot's host page redeems the ticket. Keep this page.
 * A temporary redirect: where an old screen lands follows Kinroot's screens.
 */
import {kinrootAddress} from '../../server/legacy-addresses';

export const prerender = false;

const rest = Astro.url.pathname.replace(/^\/dashboard/, '');
return Astro.redirect(kinrootAddress(rest, Astro.url.search), 302);
