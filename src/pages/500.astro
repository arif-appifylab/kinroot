---
/**
 * What a visitor sees when a page fails on the server (an error thrown while rendering), instead of an
 * empty answer, in Kinroot's design. Astro renders it with a 500 status. It reads nothing (no brand, no
 * visitor, no database): whatever broke the page must not break this one too, so it shows Kinroot's
 * default brand. The error itself is never shown here; it is in the Worker's log.
 *
 * In `npm run dev` and the editor Preview you see Astro's error overlay instead, with the stack trace.
 */
import ErrorPage from '../components/ErrorPage.astro';
import {DEFAULT_BRAND} from '../crm/lib/brand';
import CrmPublic from '../layouts/CrmPublic.astro';

export const prerender = false;

Astro.response.status = 500;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<CrmPublic brand={DEFAULT_BRAND} title="Something went wrong" noindex>
  <ErrorPage
    brand={DEFAULT_BRAND}
    code={500}
    heading="Something went wrong"
    text="This page could not be shown just now. Try again in a minute."
  />
</CrmPublic>
