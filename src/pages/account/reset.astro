---
/**
 * Choose a new password from an emailed link (`?token=`, single use, 30 minutes), in Kinroot's
 * design (src/crm/public/auth/reset.tsx): the island takes the token out of the address bar first
 * and posts it to `/site-api/auth/reset-password`.
 *
 * Server-rendered only to read the company's brand. The address carries a secret: never cached,
 * never sent on as a Referer.
 */
import AuthFallback from './_auth-fallback.astro';
import ResetPage from '../../crm/public/auth/reset';
import CrmPublic from '../../layouts/CrmPublic.astro';
import {crmBrand} from '../../server/crm/page';

export const prerender = false;

const brand = await crmBrand(Astro.request);
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---

<CrmPublic brand={brand} title="Choose a new password" noindex>
  <ResetPage client:only="react" brand={brand}>
    <AuthFallback slot="fallback" brand={brand} />
  </ResetPage>
</CrmPublic>
