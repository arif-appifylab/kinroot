---
/**
 * Confirm a NEW email address for an existing account, from the link mailed to that address
 * (`?token=`, single use, 24 hours), in Kinroot's design (src/crm/public/auth/confirm-email.tsx).
 * A button press, not the page load, uses the token: email scanners open links too. Confirming
 * signs every device out; the person signs in again with the new address.
 *
 * Server-rendered only to read the company's brand. The address carries a secret: never cached,
 * never sent on as a Referer.
 */
import AuthFallback from './_auth-fallback.astro';
import ConfirmEmailPage from '../../crm/public/auth/confirm-email';
import CrmPublic from '../../layouts/CrmPublic.astro';
import {crmBrand} from '../../server/crm/page';

export const prerender = false;

const brand = await crmBrand(Astro.request);
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---

<CrmPublic brand={brand} title="Confirm your new email" noindex>
  <ConfirmEmailPage client:only="react" brand={brand}>
    <AuthFallback slot="fallback" brand={brand} />
  </ConfirmEmailPage>
</CrmPublic>
