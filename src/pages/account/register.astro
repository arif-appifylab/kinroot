---
/**
 * Create an account, in Kinroot's design (src/crm/public/auth/register.tsx): posts to
 * `/site-api/auth/register`. With email confirmation on (the default) the answer is the same
 * whether or not the email already has an account: "check your inbox".
 *
 * Server-rendered only to read the company's brand; nothing here reads the visitor, so a short
 * shared cache is fine.
 */
import AuthFallback from './_auth-fallback.astro';
import RegisterPage from '../../crm/public/auth/register';
import CrmPublic from '../../layouts/CrmPublic.astro';
import {crmBrand} from '../../server/crm/page';

export const prerender = false;

const brand = await crmBrand(Astro.request);
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<CrmPublic brand={brand} title="Create an account" noindex>
  <RegisterPage client:only="react" brand={brand}>
    <AuthFallback slot="fallback" brand={brand} />
  </RegisterPage>
</CrmPublic>
