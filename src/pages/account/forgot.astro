---
/**
 * Forgot password, in Kinroot's design (src/crm/public/auth/forgot.tsx): posts to
 * `/site-api/auth/forgot-password`, which always answers the same (it never says whether the email
 * has an account). The email itself is relayed by the platform.
 *
 * Server-rendered only to read the company's brand; nothing here reads the visitor, so a short
 * shared cache is fine.
 */
import AuthFallback from './_auth-fallback.astro';
import ForgotPage from '../../crm/public/auth/forgot';
import CrmPublic from '../../layouts/CrmPublic.astro';
import {crmBrand} from '../../server/crm/page';

export const prerender = false;

const brand = await crmBrand(Astro.request);
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<CrmPublic brand={brand} title="Reset your password" noindex>
  <ForgotPage client:only="react" brand={brand}>
    <AuthFallback slot="fallback" brand={brand} />
  </ForgotPage>
</CrmPublic>
