---
/**
 * Sign in, in Kinroot's design (src/crm/public/auth/login.tsx): a 6-digit code by email
 * (`/site-api/auth/code`), or a password (`/site-api/auth/login`), then the two-step code when it is
 * on (`/site-api/auth/login/two-factor`; `?mfa=<challenge>` opens that step directly after a
 * one-click owner sign-in). `?next=` is where to go afterwards (same-site paths only), `?notice=`
 * explains why the visitor landed here.
 *
 * Server-rendered only to read the company's brand; nothing here reads the visitor (the island
 * asks `/site-api/me` itself), so a short shared cache is fine, except with a challenge in the URL.
 */
import AuthFallback from './_auth-fallback.astro';
import LoginPage from '../../crm/public/auth/login';
import CrmPublic from '../../layouts/CrmPublic.astro';
import {crmBrand} from '../../server/crm/page';

export const prerender = false;

const brand = await crmBrand(Astro.request);
if (Astro.url.searchParams.has('mfa')) {
  // A sign-in challenge in the address: never kept by a cache, never sent on as a Referer.
  Astro.response.headers.set('Cache-Control', 'no-store');
  Astro.response.headers.set('Referrer-Policy', 'no-referrer');
} else {
  Astro.response.headers.set('Cache-Control', 'public, max-age=60');
}
---

<CrmPublic brand={brand} title="Sign in" noindex>
  <LoginPage client:only="react" brand={brand}>
    <AuthFallback slot="fallback" brand={brand} />
  </LoginPage>
</CrmPublic>
