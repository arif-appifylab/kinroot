---
/**
 * Confirm an email address from an emailed link (`?token=`, single use, 24 hours), in Kinroot's
 * design (src/crm/public/auth/verify.tsx). The visitor presses a button to confirm: links in emails
 * are often opened by scanners, which must not use the token up. An expired link offers to send a
 * new one.
 *
 * Server-rendered only to read the company's brand. The address carries a secret: never cached,
 * never sent on as a Referer.
 */
import AuthFallback from './_auth-fallback.astro';
import VerifyPage from '../../crm/public/auth/verify';
import CrmPublic from '../../layouts/CrmPublic.astro';
import {crmBrand} from '../../server/crm/page';

export const prerender = false;

const brand = await crmBrand(Astro.request);
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---

<CrmPublic brand={brand} title="Confirm your email" noindex>
  <VerifyPage client:only="react" brand={brand}>
    <AuthFallback slot="fallback" brand={brand} />
  </VerifyPage>
</CrmPublic>
