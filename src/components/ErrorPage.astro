---
/**
 * The body of the error pages (`src/pages/404.astro`, `500.astro`) in Kinroot's design: the company's
 * logo and name, a card with what happened and a link home (as `SiteUnavailable` on the website pages).
 * Static markup, no script: it must show even when everything else failed. Its Tailwind classes are
 * found through the `@source` lines in `src/crm/styles.css`.
 */
import type {Brand} from '../crm/lib/brand';

interface Props {
  brand: Brand;
  code: number;
  heading: string;
  text: string;
}

const {brand, code, heading, text} = Astro.props;
const name = brand.name || 'Kinroot';
---

<div class="relative flex min-h-dvh flex-col overflow-hidden bg-background">
  <div class="blob -top-48 -left-40 size-[520px] bg-primary/15"></div>
  <div class="blob top-[420px] -right-48 size-[520px] bg-secondary/15"></div>
  <header class="relative z-10 mx-auto flex w-full max-w-6xl items-center px-4 py-5 sm:px-6">
    <a href="/" class="inline-flex min-w-0 items-center gap-2.5" aria-label={`${name} home`}>
      {
        brand.logo ? (
          <img src={brand.logo} alt="" class="size-9 shrink-0 rounded-xl object-contain" />
        ) : (
          <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-brand text-white shadow-glow">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 16V9" />
              <path d="M12 10.5C12 7 14.2 4.5 18 4.5c0 3.6-2.4 6-6 6Z" fill="currentColor" fill-opacity="0.25" />
              <path d="M12 12C12 9.3 10.2 7.2 7 7.2c0 2.8 2 4.8 5 4.8Z" fill="currentColor" fill-opacity="0.25" />
              <path d="M5.5 16h13" />
              <path d="M12 16v4M12 18l-3 2.5M12 18l3 2.5" />
            </svg>
          </span>
        )
      }
      <span class="truncate text-lg font-extrabold tracking-tight text-slate-900">{name}</span>
    </a>
  </header>
  <main id="main" class="relative flex flex-1 items-start justify-center px-4 pb-16 sm:px-6">
    <div class="mt-16 w-full max-w-md rounded-2xl border border-slate-100 bg-card/95 p-8 text-center shadow-soft">
      <p class="text-xs font-bold tracking-wider text-primary uppercase">Error {code}</p>
      <h1 class="mt-2 text-xl font-extrabold tracking-tight text-slate-900">{heading}</h1>
      <p class="mt-2 text-sm text-muted-foreground">{text}</p>
      <a
        href="/"
        class="mt-5 inline-flex h-10 items-center justify-center rounded-lg border border-border bg-card px-4 text-sm font-semibold text-slate-700 shadow-xs transition-all duration-200 ease-out outline-none hover:border-slate-300 hover:bg-slate-50 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
      >
        Back to the home page
      </a>
    </div>
  </main>
</div>
